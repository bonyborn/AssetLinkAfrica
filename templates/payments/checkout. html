{% extends 'base/base.html' %}

{% block title %}
Checkout
{% endblock %}

{% block content %}

<section class="checkout-page">

    <div class="checkout-container">

        <div class="checkout-summary">

            <h2>
                Booking Summary
            </h2>

            <img src="{{ booking.listing.image.url }}"
                 alt="{{ booking.listing.title }}">

            <h3>
                {{ booking.listing.title }}
            </h3>

            <p>
                {{ booking.listing.location }}
            </p>

            <span>
                KES {{ booking.listing.price }}
            </span>

        </div>

        <div class="checkout-payment">

            <form method="POST">

                {% csrf_token %}

                <h3>
                    Payment Method
                </h3>

                <select name="payment_method">

                    <option value="mpesa">
                        M-Pesa
                    </option>

                    <option value="card">
                        Card
                    </option>

                    <option value="bank">
                        Bank Transfer
                    </option>

                </select>

                <button type="submit"
                        class="btn">

                    Pay Now

                </button>

            </form>

        </div>

    </div>

</section>

{% endblock %}
