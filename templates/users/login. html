{% extends 'base/base.html' %}

{% block title %}
Login
{% endblock %}

{% block content %}

<section class="auth-page">

    <div class="auth-container">

        <h2>
            Login
        </h2>

        <form method="POST">

            {% csrf_token %}

            <input type="text"
                   name="username"
                   placeholder="Username">

            <input type="password"
                   name="password"
                   placeholder="Password">

            <button type="submit"
                    class="btn">

                Login

            </button>

        </form>

    </div>

</section>

{% endblock %}
